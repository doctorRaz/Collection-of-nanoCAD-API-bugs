<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      throwExceptions="true"
      autoReload="true">
	<!--Переменные-->
	<!--Дата время пишем из аддона-->
	<variable name="logTimestamp"
	          value="${gdc:item=logTimestamp}"/>
	<!--Имя метода-->
	<variable name="methodName"
	          value="${callsite:className=false:methodName=true:includeSourcePath=false}"/>
	<!--Имя приложения верхнего уровня, нана или еще кто, пишем из адона-->
	<variable name="appName"
	          value="${gdc:item=appName}"/>
	<variable name="logFileName"
	          value="${nlogdir:dir=logs}/${logTimestamp}${methodName}_${appName}"/>
	<!--Шаблон-->

	<variable name="fileLayout"
				value="${longdate}|${uppercase:${level}}|${logger}|${message}
					${onexception:${newline}${exception:format=ToString}}" />

	<!--https://github.com/NLog/NLog/wiki/CsvLayout-->

	<!--********** Цели ************-->
	<!--Console-->
	<targets>
		<target name="logconsole"
		        xsi:type="ColoredConsole"/>
	</targets>
	<targets async="true">
		
		<!--
		
		Parser
	<logevent time="%d{yyyy-MM-dd %H:mm:ss.ffff}" level="%p">
		<message>%m{message}</message>
		<error> %S{error}</error>
		<ui> %S{ui}</ui>
		 <property1> %S{property1}</property1>
	</logevent>
		
		-->
		
		<!--xml-->
		<target name="xmlFile" xsi:type="File" fileName="${nlogdir:dir=logs}/log.xml" >
			<layout xsi:type="XmlLayout" includeEventProperties="false" elementName='logevent'>
				<attribute name="time" layout="${longdate}" />
				<attribute name="level" layout="${level:upperCase=true}"/>
				<element  name="message" value="${message}" />
				<element name="error" value="${exception:format=ToString}" />
				<element name="ui" layout="${event-properties:userId}"/>
				<element name="property1" layout="${event-properties:property1}"/>
			</layout>
		</target>

		<!--JSON-->
		<target xsi:type="File"
				name="jsonFile"
				fileName="${nlogdir:dir=logs}/${shortdate}_${processname}_json.log">
			<layout xsi:type="JsonLayout">
				<attribute name="time" layout="${longdate}" />
				<attribute name="level" layout="${level}" />
				<attribute name="logger" layout="${logger}" />
				<attribute name="message" layout="${message}" />
				<attribute name="properties" encode="false" >
					<layout xsi:type="JsonLayout" includeEventProperties="true" maxRecursionLimit="2" />
				</attribute>
				<attribute name="exception" encode="false">
					<layout xsi:type="JsonLayout">
						<attribute name="type" layout="${exception:format=type}" />
						<attribute name="message" layout="${exception:format=message}" />
						<attribute name="stacktrace" layout="${exception:format=tostring}" />
					</layout>
				</attribute>
			</layout>
		</target>
		<!--CSV-->
		<target xsi:type="File"
				name="csvFileExample"
				fileName="${nlogdir:dir=logs}/${shortdate}_${processname}.csv">
			<layout xsi:type="CsvLayout"
					delimiter="Tab"
					withHeader="true"
					quoting="All">
				<column name="time"
						layout="${longdate}"/>
				<column name="level"
						layout="${level:upperCase=true}"/>
				<column name="logger"
						layout="${logger}"/>
				<column name="message"
						layout="${message}"/>
				<column name="exception"
						layout="${exception:format=ToString}"/>
				<column name="property1"
						layout="${event-properties:property1}"/>
				<column name="userId"
						layout="${event-properties:userId}" />
			</layout>
		</target>
		<!--File CSV Test-->
		<target xsi:type="File"
			name="csvFile"
			fileName="${nlogdir:dir=logs}/log.csv"
			layout="${longdate}|${level}|${logger}|${message}|${exception}|${event-properties:property1}|${event-properties:item=userId}"
			   />


		<!--File-->
		<target name="logfile"
				xsi:type="File"
				fileName="${logFileName}.log"/>
		<!--File Err-->
		<target name="logfileErr"
				xsi:type="File"
				fileName="${logFileName}_Err.log"/>
		<target name="logfileInfo"
				xsi:type="File"
				fileName="${nlogdir:dir=logs}/${shortdate}_${processname}.log"/>
	</targets>
	<!--Правила-->
	<rules>



		<logger name="*"
		        minlevel="Trace"
		        writeTo="xmlFile"/>

		<logger name="*"
		        minlevel="Trace"
		        writeTo="csvFile"/>

		<logger name="*"
		        minlevel="Trace"
		        writeTo="logconsole"/>
		<logger name="*"
		        minlevel="Trace"
		        writeTo="logfile"/>
		<logger name="*"
		        minlevel="Error"
		        writeTo="logfileErr"/>
		<logger name="*"
		        level="Info"
		        writeTo="logfileInfo"/>
		<logger name="*"
		        minlevel="Trace"
		        writeTo="csvFileExample"/>
		<logger name="*"
		        minlevel="Trace"
		        writeTo="jsonFile"/>
	</rules>
</nlog>
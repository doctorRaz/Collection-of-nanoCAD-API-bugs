		  SourceFiles="..\Test.OpenDwg.NC.23.1\Config\NLog.$(Configuration).config"
		  DestinationFiles="$(OutDir)NLog.config"
		  SkipUnchangedFiles="true" />
	</Target>-->

</Project>

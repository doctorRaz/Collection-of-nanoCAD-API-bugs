<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0-windows</TargetFramework>
		<PlatformTarget>x64</PlatformTarget>
		<RootNamespace>dRz.nanoCADbugs</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);NC;NC26</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="_draft\**" />
	  <EmbeddedResource Remove="_draft\**" />
	  <None Remove="_draft\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="nanoCAD.Platform.NET" Version="26.0.7226.4926" />
	</ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      throwExceptions="true"
      autoReload="true">

	<!--Переменные-->

	<!--Дата время пишем из аддона-->

	<variable name="logTimestamp"
	          value="${gdc:item=logTimestamp}"/>

	<!--Имя метода-->
	<variable name="methodName"
	          value="${callsite:className=false:methodName=true:includeSourcePath=false}"/>

	<!--Имя приложения верхнего уровня, нана или еще кто, пишем из адона-->
	<variable name="appName"
	          value="${gdc:item=appName}"/>

	<variable name="logFileName"
	          value="${basedir}/logs/${logTimestamp}${methodName}_${appName}"/>

	<!--Шаблон-->


	<!--Цели-->
	<targets  >
		<target name="logconsole"
		        xsi:type="ColoredConsole"
				/>
	</targets>

	<targets async="true">
		<target name="logfile"
		        xsi:type="File"
		        fileName="${logFileName}.log"/>
		<target name="logfileErr"
		        xsi:type="File"
		        fileName="${logFileName}_Err.log"/>
		<target name="logfileInfo"
		        xsi:type="File"
		        fileName="${basedir}/logs/${shortdate}_${processname}.log"/>
	</targets>

	<!--Правила-->
	<rules>
		<logger name="*"
		        minlevel="Trace"
		        writeTo="logconsole"/>
		<logger name="*"
		        minlevel="Trace"
		        writeTo="logfile"/>
		<logger name="*"
		        minlevel="Error"
		        writeTo="logfileErr"/>
		<logger name="*"
		        level="Info"
		        writeTo="logfileInfo"/>
	</rules>
</nlog>